<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= html_escape($title ?? 'Dashboard GM Admin') ?></title>
    <style>
        :root{
            --bg:#eef3f8;
            --panel:#ffffff;
            --panel-soft:#f8fbfe;
            --ink:#102033;
            --muted:#607287;
            --line:#d9e3ee;
            --brand:#176b87;
            --brand-deep:#0f5268;
            --accent:#7c9a42;
            --accent-soft:#edf5dc;
            --warn:#d97706;
            --risk:#dc2626;
            --ok:#16a34a;
            --shadow:0 18px 46px rgba(16,32,51,.10);
        }
        *{box-sizing:border-box}
        body{
            margin:0;
            min-height:100vh;
            font-family:Segoe UI,Arial,Helvetica,sans-serif;
            color:var(--ink);
            background:
                radial-gradient(circle at top left, rgba(23,107,135,.12), transparent 22%),
                linear-gradient(180deg,#f8fbff 0,var(--bg) 100%);
        }
        a{color:inherit}
        .shell{
            min-height:100vh;
            display:grid;
            grid-template-columns:250px minmax(0,1fr);
        }
        .sidebar{
            display:flex;
            flex-direction:column;
            gap:12px;
            padding:14px;
            border-right:1px solid rgba(217,227,238,.95);
            background:rgba(255,255,255,.94);
            backdrop-filter:blur(10px);
            position:sticky;
            top:0;
            height:100vh;
            overflow:auto;
        }
        .brand{
            display:flex;
            align-items:center;
            gap:12px;
            padding-bottom:8px;
            border-bottom:1px solid rgba(217,227,238,.7);
        }
        .brand img{
            width:42px;
            height:42px;
            object-fit:contain;
        }
        .brand h1{
            margin:0;
            font-size:17px;
            line-height:1.15;
            letter-spacing:-.02em;
        }
        .brand p{
            margin:4px 0 0;
            color:var(--muted);
            font-size:10px;
            line-height:1.4;
        }
        .user-card,.nav-card,.action-card,.stats-card,.table-card{
            border:1px solid rgba(217,227,238,.95);
            border-radius:12px;
            background:#fff;
            box-shadow:0 1px 3px rgba(16,32,51,.08);
        }
        .user-card{
            padding:11px 12px;
            display:grid;
            gap:6px;
        }
        .user-card .label{
            color:var(--muted);
            font-size:11px;
            font-weight:900;
            text-transform:uppercase;
            letter-spacing:.04em;
        }
        .user-card strong{
            font-size:14px;
        }
        .user-card small{
            color:var(--muted);
            font-weight:700;
        }
        .nav-card{
            padding:6px;
            display:grid;
            gap:4px;
        }
        .nav-card button{
            border:0;
            border-radius:10px;
            background:transparent;
            color:var(--muted);
            font-size:12px;
            font-weight:850;
            text-align:left;
            padding:10px 11px;
            cursor:pointer;
            border-left:3px solid transparent;
        }
        .nav-card button.active,
        .nav-card button:hover{
            background:rgba(23,107,135,.08);
            color:var(--brand);
            border-left-color:var(--brand);
        }
        .sidebar-footer{
            margin-top:auto;
            display:grid;
            gap:10px;
        }
        .sidebar-footer .primary,
        .sidebar-footer .secondary{
            width:100%;
            height:38px;
            border-radius:10px;
            border:0;
            font-size:12px;
            font-weight:900;
            cursor:pointer;
            text-decoration:none;
            display:inline-flex;
            align-items:center;
            justify-content:center;
        }
        .sidebar-footer .primary{
            background:linear-gradient(180deg,var(--brand),var(--brand-deep));
            color:#fff;
        }
        .sidebar-footer .secondary{
            background:#fff;
            color:var(--brand);
            border:1px solid var(--line);
        }
        .content{
            min-width:0;
            padding:12px;
            display:grid;
            gap:10px;
            align-content:start;
            grid-auto-rows:min-content;
        }
        .topbar{
            border:1px solid rgba(217,227,238,.95);
            border-radius:12px;
            background:#fff;
            box-shadow:0 1px 3px rgba(16,32,51,.08);
            padding:12px 14px;
            display:flex;
            gap:12px;
            align-items:flex-start;
            justify-content:space-between;
        }
        .topbar h2{
            margin:0;
            font-size:19px;
            letter-spacing:-.03em;
        }
        .topbar p{
            margin:3px 0 0;
            color:var(--muted);
            font-size:11px;
            line-height:1.35;
            max-width:560px;
        }
        .topbar-actions{
            display:flex;
            gap:8px;
            flex-wrap:wrap;
            justify-content:flex-end;
        }
        .topbar-actions a,
        .topbar-actions button{
            height:34px;
            border-radius:8px;
            border:0;
            padding:0 12px;
            font-size:12px;
            font-weight:900;
            cursor:pointer;
            text-decoration:none;
            display:inline-flex;
            align-items:center;
            justify-content:center;
        }
        .topbar-actions .primary{
            background:linear-gradient(180deg,var(--brand),var(--brand-deep));
            color:#fff;
        }
        .topbar-actions .secondary{
            background:#fff;
            color:var(--brand);
            border:1px solid var(--line);
        }
        .grid{
            display:grid;
            grid-template-columns:repeat(4,minmax(0,1fr));
            gap:8px;
        }
        .summary-kpi-grid{
            display:grid;
            grid-template-columns:repeat(4,minmax(0,1fr));
            gap:8px;
        }
        .stats-card{
            padding:12px 14px;
            display:grid;
            gap:6px;
            position:relative;
            transition:transform .15s ease, box-shadow .15s ease;
        }
        .stats-card:hover{
            box-shadow:0 6px 18px rgba(16,32,51,.07);
        }
        .stats-card .stats-label{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:6px;
            color:var(--muted);
            font-size:10px;
            font-weight:900;
            text-transform:uppercase;
            letter-spacing:.04em;
        }
        .stats-card .stats-value-row{
            display:flex;
            align-items:baseline;
            gap:5px;
        }
        .stats-card strong{
            font-size:22px;
            line-height:1.1;
            letter-spacing:-.03em;
            color:var(--ink);
        }
        .stats-card small{
            color:var(--muted);
            font-weight:700;
            font-size:11px;
        }
        .stats-card .stats-sub{
            color:var(--muted);
            font-size:11px;
            line-height:1.35;
        }
        .stats-card.highlight{
            background:linear-gradient(180deg,#ffffff,#f0f7fb);
            border-color:rgba(23,107,135,.3);
        }
        .stats-card.highlight strong{
            color:var(--brand);
        }
        .stats-card.accent{
            background:linear-gradient(180deg,#ffffff,#f5f9eb);
            border-color:rgba(124,154,66,.3);
        }
        .stats-card.accent strong{
            color:#4d661b;
        }
        .stats-card.warn{
            background:linear-gradient(180deg,#ffffff,#fffbf0);
            border-color:rgba(217,119,6,.3);
        }
        .stats-card.warn strong{
            color:var(--warn);
        }
        .badge-pill{
            display:inline-flex;
            align-items:center;
            gap:4px;
            padding:2px 7px;
            border-radius:999px;
            font-size:9px;
            font-weight:900;
            letter-spacing:.03em;
            text-transform:uppercase;
            background:rgba(23,107,135,.1);
            color:var(--brand);
        }
        .badge-pill.good{background:#dcfce7;color:#15803d}
        .badge-pill.warn{background:#fef3c7;color:#b45309}
        .badge-pill.risk{background:#fee2e2;color:#b91c1c}
        .summary-detail-grid{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:10px;
        }
        .summary-box{
            border:1px solid rgba(217,227,238,.95);
            border-radius:12px;
            background:#fff;
            box-shadow:0 1px 3px rgba(16,32,51,.08);
            padding:14px;
            display:grid;
            gap:10px;
        }
        .summary-box h4{
            margin:0;
            font-size:13px;
            font-weight:900;
            text-transform:uppercase;
            letter-spacing:.03em;
            color:var(--brand);
            display:flex;
            align-items:center;
            justify-content:space-between;
        }
        .formula-list{
            display:grid;
            gap:7px;
        }
        .formula-item{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:7px 10px;
            border-radius:8px;
            background:var(--panel-soft);
            font-size:12px;
        }
        .formula-item span{
            color:var(--muted);
            font-weight:600;
        }
        .formula-item strong{
            color:var(--ink);
            font-weight:850;
        }
        .breakdown-table{
            width:100%;
            border-collapse:collapse;
            font-size:12px;
        }
        .breakdown-table th{
            text-align:left;
            padding:8px 10px;
            background:var(--panel-soft);
            color:var(--muted);
            font-size:10px;
            font-weight:900;
            text-transform:uppercase;
            letter-spacing:.04em;
            border-bottom:1px solid var(--line);
        }
        .breakdown-table th.num, .breakdown-table td.num{
            text-align:right;
        }
        .breakdown-table td{
            padding:8px 10px;
            border-bottom:1px solid var(--line);
        }
        .progress-bar-wrap{
            width:100%;
            height:6px;
            background:#e2e8f0;
            border-radius:999px;
            overflow:hidden;
            margin-top:4px;
        }
        .progress-bar-fill{
            height:100%;
            background:var(--brand);
            border-radius:999px;
            transition:width .3s ease;
        }
        .topbar-scope{
            display:inline-flex;
            align-items:center;
            gap:6px;
            background:var(--panel-soft);
            border:1px solid var(--line);
            border-radius:8px;
            padding:3px 10px;
            font-size:12px;
            font-weight:700;
        }
        .topbar-scope input[type="date"]{
            border:1px solid rgba(217,227,238,.9);
            background:#fff;
            border-radius:6px;
            height:26px;
            padding:0 6px;
            font-size:12px;
            font-weight:850;
            color:var(--ink);
            cursor:pointer;
            outline:none;
        }
        .topbar-scope input[type="date"]:hover{
            border-color:rgba(23,107,135,.35);
        }
        .period-pill{
            display:inline-flex;
            align-items:center;
            justify-content:center;
            padding:2px 8px;
            height:22px;
            border-radius:5px;
            font-size:11px;
            font-weight:900;
            white-space:nowrap;
            user-select:none;
        }
        .period-pill.mid{background:rgba(23,107,135,.14);color:#0f5268;border:1px solid rgba(23,107,135,.22)}
        .period-pill.end{background:rgba(135,169,34,.16);color:#4a631e;border:1px solid rgba(135,169,34,.25)}
        .period-pill.range{background:rgba(100,116,139,.16);color:#334155;border:1px solid rgba(100,116,139,.28)}
        .scope-spinner{
            width:13px;
            height:13px;
            border:2px solid rgba(23,107,135,.2);
            border-top-color:var(--brand);
            border-radius:50%;
            animation:globalSpin .8s linear infinite;
            display:none;
            flex-shrink:0;
        }
        .topbar-scope.loading .scope-spinner{
            display:inline-block;
        }
        .topbar-scope.loading input[type="date"]{
            opacity:0.6;
            pointer-events:none;
        }
        .global-loading-overlay{
            position:fixed;
            inset:0;
            z-index:99999;
            display:none;
            align-items:center;
            justify-content:center;
            background:rgba(248,251,255,.75);
            backdrop-filter:blur(3px);
        }
        .global-loading-overlay.active{
            display:flex;
        }
        .global-loading-card{
            min-width:min(280px,86vw);
            padding:24px 28px;
            border:1px solid rgba(219,228,238,.95);
            border-radius:14px;
            background:rgba(255,255,255,.98);
            box-shadow:0 24px 60px rgba(16,32,51,.18);
            display:grid;
            justify-items:center;
            gap:10px;
            text-align:center;
        }
        .global-loading-card img{
            width:52px;
            height:52px;
            animation:globalSpin .9s linear infinite;
        }
        .global-loading-card span{
            color:var(--brand-deep);
            font-size:14px;
            font-weight:900;
            letter-spacing:.02em;
        }
        .global-loading-card small{
            color:var(--muted);
            font-size:12px;
            font-weight:600;
        }
        @keyframes globalSpin{to{transform:rotate(360deg)}}
        .chip-container{
            display:flex;
            flex-wrap:wrap;
            gap:6px;
        }
        .style-chip{
            display:inline-flex;
            align-items:center;
            gap:6px;
            padding:4px 10px;
            border-radius:20px;
            background:rgba(23,107,135,.08);
            border:1px solid rgba(23,107,135,.2);
            font-size:11px;
            font-weight:800;
            color:var(--brand);
        }
        .style-chip b{
            background:var(--brand);
            color:#fff;
            padding:1px 6px;
            border-radius:10px;
            font-size:10px;
        }
        .section{
            display:none;
            gap:8px;
            align-content:start;
        }
        .section.active{
            display:grid;
            align-content:start;
        }
        .section-head{
            display:flex;
            align-items:flex-end;
            justify-content:space-between;
            gap:10px;
            padding:2px 2px 0;
        }
        .section-head h3{
            margin:0;
            font-size:14px;
            text-transform:uppercase;
            letter-spacing:.03em;
        }
        .section-head p{
            margin:0;
            color:var(--muted);
            font-size:10px;
            line-height:1.35;
        }
        .action-grid{
            display:grid;
            grid-template-columns:repeat(3,minmax(0,1fr));
            gap:8px;
        }
        .action-card{
            padding:11px;
            display:grid;
            gap:7px;
        }
        .action-card .tag{
            display:inline-flex;
            align-items:center;
            gap:6px;
            width:max-content;
            padding:5px 9px;
            border-radius:999px;
            background:rgba(23,107,135,.08);
            color:var(--brand);
            font-size:10px;
            font-weight:900;
            text-transform:uppercase;
            letter-spacing:.04em;
        }
        .action-card h4{
            margin:0;
            font-size:14px;
        }
        .action-card p{
            margin:0;
            color:var(--muted);
            font-size:11px;
            line-height:1.4;
        }
        .action-card .buttons{
            display:flex;
            gap:8px;
            flex-wrap:wrap;
            margin-top:2px;
        }
        .action-card .buttons a,
        .action-card .buttons button{
            height:32px;
            border-radius:8px;
            border:0;
            padding:0 11px;
            font-size:12px;
            font-weight:900;
            cursor:pointer;
            text-decoration:none;
            display:inline-flex;
            align-items:center;
            justify-content:center;
        }
        .action-card .buttons .primary{
            background:linear-gradient(180deg,var(--brand),var(--brand-deep));
            color:#fff;
        }
        .action-card .buttons .secondary{
            background:#fff;
            color:var(--brand);
            border:1px solid var(--line);
        }
        .table-card{
            padding:11px;
            display:grid;
            gap:8px;
        }
        .analytics-settings-grid{
            display:grid;
            grid-template-columns:repeat(2,minmax(0,1fr));
            gap:8px;
        }
        .analytics-setting-card{
            border:1px solid var(--line);
            border-radius:10px;
            background:var(--panel-soft);
            padding:10px 11px;
            display:grid;
            gap:6px;
        }
        .analytics-setting-card label{
            display:flex;
            align-items:center;
            gap:8px;
            font-size:12px;
            font-weight:850;
            color:var(--ink);
            cursor:pointer;
        }
        .analytics-setting-card small{
            color:var(--muted);
            font-size:10px;
            line-height:1.35;
        }
        .analytics-setting-meta{
            display:flex;
            align-items:center;
            gap:10px;
            flex-wrap:wrap;
        }
        .analytics-setting-meta label{
            color:var(--muted);
            font-size:10px;
            font-weight:900;
            text-transform:uppercase;
            letter-spacing:.04em;
        }
        .analytics-setting-meta select{
            height:32px;
            border:1px solid var(--line);
            border-radius:8px;
            background:#fff;
            color:var(--ink);
            font-size:12px;
            padding:0 10px;
            outline:none;
        }
        .analytics-setting-meta input{
            height:32px;
            border:1px solid var(--line);
            border-radius:8px;
            background:#fff;
            color:var(--ink);
            font-size:12px;
            padding:0 10px;
            outline:none;
            width:140px;
        }
        .table-toolbar{
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:10px;
            flex-wrap:wrap;
        }
        .datatable-meta{
            display:flex;
            align-items:center;
            gap:8px;
            flex-wrap:wrap;
        }
        .datatable-meta label{
            color:var(--muted);
            font-size:10px;
            font-weight:900;
            text-transform:uppercase;
            letter-spacing:.04em;
        }
        .datatable-meta input,
        .datatable-meta select{
            height:32px;
            border:1px solid var(--line);
            border-radius:8px;
            background:#fff;
            color:var(--ink);
            font-size:12px;
            padding:0 10px;
            outline:none;
        }
        .datatable-meta input{
            width:220px;
            max-width:50vw;
        }
        .datatable-info{
            color:var(--muted);
            font-size:11px;
            font-weight:750;
        }
        .table-scroll{
            overflow:auto;
            border:1px solid var(--line);
            border-radius:12px;
            background:#fff;
        }
        table{
            width:100%;
            border-collapse:collapse;
            min-width:700px;
        }
        th,td{
            padding:8px 9px;
            border-bottom:1px solid #edf2f7;
            font-size:12px;
            white-space:nowrap;
        }
        th{
            position:sticky;
            top:0;
            background:#f8fbfe;
            color:var(--muted);
            text-align:left;
            font-size:10px;
            text-transform:uppercase;
            letter-spacing:.04em;
        }
        tr:last-child td{border-bottom:0}
        .num{text-align:right}
        .pill{
            display:inline-flex;
            align-items:center;
            padding:5px 9px;
            border-radius:999px;
            background:var(--accent-soft);
            color:#4c6b1f;
            font-size:11px;
            font-weight:900;
            text-transform:uppercase;
        }
        .notice{
            border:1px dashed rgba(23,107,135,.32);
            border-radius:10px;
            background:rgba(23,107,135,.05);
            padding:10px 11px;
            color:var(--muted);
            font-size:11px;
            line-height:1.45;
        }
        .form-card{
            display:grid;
            gap:12px;
        }
        .form-grid{
            display:grid;
            grid-template-columns:repeat(2,minmax(0,1fr));
            gap:10px;
        }
        .field{
            display:grid;
            gap:7px;
        }
        .field label{
            color:var(--muted);
            font-size:10px;
            font-weight:900;
            text-transform:uppercase;
            letter-spacing:.04em;
        }
        .field input,
        .field textarea{
            width:100%;
            border:1px solid var(--line);
            border-radius:10px;
            background:#fff;
            color:var(--ink);
            font-size:12px;
            outline:none;
            padding:9px 10px;
        }
        .field input:focus,
        .field textarea:focus{
            border-color:rgba(23,107,135,.58);
            box-shadow:0 0 0 3px rgba(23,107,135,.10);
        }
        .field textarea{
            min-height:96px;
            resize:vertical;
            line-height:1.5;
        }
        .field .helper{
            color:var(--muted);
            font-size:10px;
            line-height:1.45;
        }
        .save-row{
            display:flex;
            gap:10px;
            align-items:center;
            justify-content:flex-end;
            flex-wrap:wrap;
        }
        .save-row .secondary,
        .save-row .primary{
            height:32px;
            border-radius:8px;
            border:0;
            padding:0 11px;
            font-size:12px;
            font-weight:900;
            cursor:pointer;
            text-decoration:none;
            display:inline-flex;
            align-items:center;
            justify-content:center;
        }
        .save-row .primary{
            background:linear-gradient(180deg,var(--brand),var(--brand-deep));
            color:#fff;
        }
        .save-row .secondary{
            background:#fff;
            color:var(--brand);
            border:1px solid var(--line);
        }
        .smv-table{
            min-width:960px;
        }
        .smv-table td,
        .smv-table th{
            vertical-align:middle;
        }
        .smv-table td:first-child{
            width:56px;
        }
        .smv-input{
            max-width:112px;
            text-align:right;
        }
        .smv-process-input{
            max-width:80px;
            text-align:right;
            font-weight:700;
        }
        .smv-process-list{
            display:flex;
            flex-direction:column;
            gap:5px;
            align-items:flex-end;
        }
        .smv-process-row{
            display:flex;
            align-items:center;
            gap:6px;
            justify-content:flex-end;
        }
        .smv-process-label{
            font-size:11px;
            font-weight:700;
            color:var(--muted);
            min-width:26px;
            text-align:right;
        }
        .smv-sub-input{
            max-width:86px;
            text-align:right;
            padding:5px 8px;
            height:30px;
            font-size:12px;
            font-weight:700;
        }
        .smv-total-badge{
            display:inline-flex;
            align-items:center;
            gap:4px;
            font-size:11px;
            font-weight:800;
            color:var(--brand);
            background:rgba(23,107,135,.09);
            padding:2px 8px;
            border-radius:6px;
            margin-top:2px;
            border:1px solid rgba(23,107,135,.2);
        }
        .smv-toggle{
            width:16px;
            height:16px;
            accent-color:var(--brand);
        }
        .smv-bulk-actions{
            display:inline-flex;
            gap:6px;
            align-items:center;
            margin-left:4px;
        }
        .smv-bulk-actions button{
            height:32px;
            padding:0 10px;
            font-size:11px;
            font-weight:800;
            border-radius:8px;
            border:1px solid var(--line);
            background:#fff;
            color:var(--brand);
            cursor:pointer;
            transition:background .15s, border-color .15s;
        }
        .smv-bulk-actions button:hover{
            background:rgba(23,107,135,.08);
            border-color:var(--brand);
        }
        .smv-table .smv-empty-row td{
            padding:18px 12px;
            color:var(--muted);
            text-align:center;
        }
        .datatable-footer{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
            flex-wrap:wrap;
        }
        .datatable-pagination{
            display:flex;
            gap:6px;
            align-items:center;
            flex-wrap:wrap;
        }
        .datatable-pagination button{
            height:30px;
            min-width:30px;
            border:1px solid var(--line);
            border-radius:8px;
            background:#fff;
            color:var(--ink);
            font-size:12px;
            font-weight:850;
            cursor:pointer;
            padding:0 10px;
        }
        .datatable-pagination button.active{
            background:var(--brand);
            color:#fff;
            border-color:var(--brand);
        }
        .datatable-pagination button:disabled{
            opacity:.45;
            cursor:not-allowed;
        }
        .smv-status{
            font-size:11px;
            font-weight:850;
        }
        .smv-status.good{color:var(--ok)}
        .smv-status.warn{color:var(--warn)}
        .smv-status.risk{color:var(--risk)}
        .calendar-tools{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
            flex-wrap:wrap;
            margin-top:2px;
        }
        .calendar-tools button{
            height:30px;
            border:1px solid var(--line);
            border-radius:8px;
            background:#fff;
            color:var(--ink);
            font-weight:850;
            padding:0 10px;
            cursor:pointer;
        }
        .calendar-month-title{
            color:var(--ink);
            font-size:14px;
            font-weight:900;
            text-transform:uppercase;
            letter-spacing:.03em;
        }
        .calendar-summary{
            display:grid;
            grid-template-columns:repeat(4,minmax(0,1fr));
            gap:6px;
        }
        .calendar-summary-item{
            border:1px solid var(--line);
            border-radius:8px;
            background:var(--panel-soft);
            padding:8px 9px;
        }
        .calendar-summary-item span{
            display:block;
            color:var(--muted);
            font-size:9px;
            font-weight:850;
            text-transform:uppercase;
        }
        .calendar-summary-item b{
            display:block;
            margin-top:4px;
            color:var(--ink);
            font-size:13px;
            font-weight:900;
        }
        .calendar-summary-item small{
            display:block;
            margin-top:3px;
            color:var(--muted);
            font-size:9px;
            font-weight:750;
        }
        .calendar-grid{
            display:grid;
            grid-template-columns:repeat(7,minmax(0,1fr));
            gap:3px;
        }
        .calendar-head{
            padding:3px 2px;
            color:var(--muted);
            font-size:10px;
            font-weight:900;
            text-align:center;
            text-transform:uppercase;
        }
        .calendar-day{
            min-height:62px;
            border:1px solid var(--line);
            border-radius:8px;
            background:#fff;
            color:var(--ink);
            display:grid;
            grid-template-rows:auto 1fr;
            align-items:start;
            padding:7px;
            text-align:left;
            cursor:pointer;
        }
        .calendar-day b{
            font-size:12px;
            font-weight:900;
        }
        .calendar-day span{
            align-self:end;
            color:var(--muted);
            font-size:9px;
            font-weight:800;
            text-transform:uppercase;
            line-height:1.2;
        }
        .calendar-day.out{opacity:.38}
        .calendar-day.sunday{background:#fff7f7}
        .calendar-day.work{border-color:#bbf7d0;background:#f0fdf4;color:#166534}
        .calendar-day.half{border-color:#fed7aa;background:#fff7ed;color:#9a3412}
        .calendar-day.quarter{border-color:#bfdbfe;background:#eff6ff;color:#1d4ed8}
        .calendar-day.holiday{border-color:#fecaca;background:#fee2e2;color:#991b1b}
        .calendar-day.today{box-shadow:inset 0 0 0 2px var(--brand)}
        .calendar-legend{
            display:flex;
            gap:8px;
            align-items:center;
            margin-top:8px;
            color:var(--muted);
            font-size:11px;
            font-weight:750;
            flex-wrap:wrap;
        }
        .calendar-legend i{
            width:9px;
            height:9px;
            border-radius:3px;
            display:inline-block;
            margin-right:5px;
            vertical-align:-1px;
        }
        .legend-sunday{background:#fff7f7;border:1px solid var(--line)}
        .legend-work{background:#f0fdf4;border:1px solid #bbf7d0}
        .legend-half{background:#fff7ed;border:1px solid #fed7aa}
        .legend-quarter{background:#eff6ff;border:1px solid #bfdbfe}
        .legend-off{background:#fee2e2;border:1px solid #fecaca}
        .calendar-help{
            margin-top:6px;
            color:var(--muted);
            font-size:11px;
            font-weight:750;
        }
        .modal-backdrop{
            position:fixed;
            inset:0;
            display:none;
            align-items:center;
            justify-content:center;
            padding:10px;
            background:rgba(16,32,51,.52);
            backdrop-filter:blur(3px);
            z-index:1200;
        }
        .modal-backdrop.open{display:flex}
        .detail-modal{
            width:min(980px,96vw);
            max-height:calc(100vh - 24px);
            overflow:auto;
            border-radius:12px;
            border:1px solid rgba(217,227,238,.95);
            background:rgba(255,255,255,.98);
            box-shadow:0 8px 24px rgba(16,32,51,.16);
        }
        .modal-head{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
            padding:10px 12px 0;
        }
        .modal-head h3{
            margin:0;
            font-size:14px;
            text-transform:uppercase;
            letter-spacing:.03em;
        }
        .modal-close{
            width:30px;
            height:30px;
            border:0;
            border-radius:8px;
            background:#f1f5f9;
            color:var(--muted);
            font-size:18px;
            line-height:1;
            cursor:pointer;
        }
        .modal-body{
            padding:10px 12px 12px;
            display:grid;
            gap:8px;
        }
        @media (max-width: 1180px){
            .shell{grid-template-columns:1fr}
            .sidebar{
                border-right:0;
                border-bottom:1px solid rgba(217,227,238,.95);
                position:static;
                height:auto;
            }
            .grid,.summary-kpi-grid,.action-grid,.form-grid,.calendar-summary,.summary-detail-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
        }
        @media (max-width: 720px){
            .content{padding:10px}
            .topbar{padding:10px;flex-direction:column;align-items:flex-start}
            .topbar-actions{justify-content:flex-start}
            .grid,.summary-kpi-grid,.action-grid,.form-grid,.calendar-summary,.summary-detail-grid{grid-template-columns:1fr}
            .calendar-grid{gap:4px}
            .calendar-day{min-height:62px;padding:6px}
        }
    </style>
</head>
<body>
<?php
$user = isset($user) && is_array($user) ? $user : array();
$user_name = !empty($user['full_name']) ? $user['full_name'] : (!empty($user['username']) ? $user['username'] : 'Administrator');
$user_role = !empty($user['role']) ? $user['role'] : 'admin';
$dashboard_data = isset($initial_dashboard_payload['dashboard_data']) && is_array($initial_dashboard_payload['dashboard_data'])
    ? $initial_dashboard_payload['dashboard_data']
    : array();
$holiday_settings = isset($dashboard_data['holiday_settings']) && is_array($dashboard_data['holiday_settings'])
    ? $dashboard_data['holiday_settings']
    : array('holidays' => array(), 'half_days' => array(), 'quarter_days' => array(), 'work_days' => array());
$style_catalog = isset($style_smv_catalog['styles']) && is_array($style_smv_catalog['styles']) ? $style_smv_catalog['styles'] : array();
$style_smv_catalog = isset($style_smv_catalog) && is_array($style_smv_catalog) ? $style_smv_catalog : array('styles' => array());
$selected_date = isset($selected_date) && !empty($selected_date) ? $selected_date : date('Y-m-d');
if (is_numeric($selected_date)) {
    $selected_date = date('Y-m-d');
}

$kpis = isset($dashboard_data['kpis']) && is_array($dashboard_data['kpis']) ? $dashboard_data['kpis'] : array();
$initial_total_output = isset($kpis['total_output']) ? (float) $kpis['total_output'] : 0;
$initial_balance_qty = isset($kpis['balance_qty']) ? (float) $kpis['balance_qty'] : 0;
$initial_balance_qty_ofc = isset($kpis['balance_qty_with_ofc']) ? (float) $kpis['balance_qty_with_ofc'] : $initial_balance_qty;
$initial_remaining_days = isset($kpis['prod_days_left']) ? (float) $kpis['prod_days_left'] : (isset($kpis['remaining_days']) ? (float) $kpis['remaining_days'] : 0);

$initial_active_smv = array();
if (!empty($style_smv_catalog['running_styles']) && is_array($style_smv_catalog['running_styles'])) {
    foreach ($style_smv_catalog['running_styles'] as $s) {
        if (isset($s['smv']) && is_numeric($s['smv']) && (float) $s['smv'] > 0) {
            $initial_active_smv[] = $s;
        }
    }
} elseif (!empty($style_catalog) && is_array($style_catalog)) {
    foreach ($style_catalog as $s) {
        if (!empty($s['show_in_dashboard']) && isset($s['smv']) && is_numeric($s['smv']) && (float) $s['smv'] > 0) {
            $initial_active_smv[] = $s;
        }
    }
}
$initial_smv_nums = array();
foreach ($initial_active_smv as $s) {
    $initial_smv_nums[] = (float) $s['smv'];
}
$initial_avg_smv = count($initial_smv_nums) > 0 ? (array_sum($initial_smv_nums) / count($initial_smv_nums)) : null;
$initial_direct_actual = isset($analytics_settings['direct_actual']) && $analytics_settings['direct_actual'] !== NULL && $analytics_settings['direct_actual'] !== '' ? (float) $analytics_settings['direct_actual'] : null;

$initial_balance_breakdown = !empty($dashboard_data['balance_breakdown']) && is_array($dashboard_data['balance_breakdown'])
    ? $dashboard_data['balance_breakdown']
    : (!empty($dashboard_data['qty_pdk_vs_output']) && is_array($dashboard_data['qty_pdk_vs_output']) ? $dashboard_data['qty_pdk_vs_output'] : array());

$source_label = !empty($dashboard_data['source']) ? $dashboard_data['source'] : 'RPA Engage';
$source_updated_at = !empty($dashboard_data['source_updated_at']) ? $dashboard_data['source_updated_at'] : '';
?>
