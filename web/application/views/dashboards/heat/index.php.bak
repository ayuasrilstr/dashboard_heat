                    <button type="button" class="primary" id="managementFormulaOpen" data-i18n="open">Buka</button>
                </section>
            </div>
        </div>
    </section>
</div>

<div class="modal-backdrop" id="formulaGuideModal" role="dialog" aria-modal="true" aria-labelledby="formulaGuideTitle">
