                            <div class="running-style-list" id="runningStyleList">
<?php
$initial_smv_list = array();
if (isset($style_smv_catalog['running_styles']) && is_array($style_smv_catalog['running_styles'])) {
    $initial_smv_list = $style_smv_catalog['running_styles'];
} elseif (isset($style_smv_catalog['styles']) && is_array($style_smv_catalog['styles'])) {
    foreach ($style_smv_catalog['styles'] as $s) {
        if (!empty($s['show_in_dashboard'])) {
            $initial_smv_list[] = $s;
        }
    }
}
$initial_smv_vals = array();
foreach ($initial_smv_list as $s) {
    if (isset($s['smv']) && is_numeric($s['smv']) && (float) $s['smv'] > 0) {
        $initial_smv_vals[] = (float) $s['smv'];
    }
}
$initial_avg_smv = count($initial_smv_vals) > 0 ? (array_sum($initial_smv_vals) / count($initial_smv_vals)) : null;
?>
<?php if ($initial_avg_smv !== null): ?>
                                <div class="running-style-chip" style="justify-content:center;" <?= count($initial_smv_vals) > 1 ? 'title="Rata-rata dari ' . count($initial_smv_vals) . ' style berjalan"' : '' ?>>
                                    <span class="style-smv" style="margin-left:0;font-size:clamp(16px,1.15vw,22px);"><?= number_format($initial_avg_smv, 2, '.', '') ?></span>
                                </div>
<?php elseif (!empty($initial_smv_list)): ?>
                                <div class="running-style-empty">SMV style belum tersedia.</div>
<?php else: ?>
                                <div class="running-style-empty">Tidak ada style berjalan di APS pada periode ini.</div>
<?php endif; ?>
                            </div>
                        </div>
                    </div>
                </article>
                <article class="kpi balance-detail" style="display:none;"><span data-i18n="qty_short_label">Qty Yang Kurang :</span><div class="kpi-balance-list" id="balanceBreakdown"></div></article>
